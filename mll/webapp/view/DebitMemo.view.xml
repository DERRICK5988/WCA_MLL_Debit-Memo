                        <t:template>
                            <!-- <Text id="_IDGenText7" text="({DebitMemo>Product}) {DebitMemo>ProductDescription}" tooltip="{i18n>Product}" wrapping="false"/> -->
                            <Text text="{= ${DebitMemo>Product} ? '(' + ${DebitMemo>Product} + ') ' + ${DebitMemo>ProductDescription} : ''}" tooltip="{DebitMemo>Product}" wrapping="false"/>
                        </t:template>
                    </t:Column>
