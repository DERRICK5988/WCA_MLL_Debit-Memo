        <!-- DynamicPage Content -->
        <f:content>
            <t:Table width="{= !${device>/browser/msie}? 'auto' : '100rem'}" id="idDebitMemoTable" fixedColumnCount="2" rowMode="Auto" enableBusyIndicator="true" rows="{ path: 'DebitMemo>/Items' }" selectionMode="Multi" enableColumnReordering="true" rowSelectionChange="onDebitMemoRowSelected" sap.ui.fl:flexibility="sap/m/flexibility/EngineFlex" ariaLabelledBy="title">
                <t:extension>
                    <OverflowToolbar id="_IDGenOverflowToolbar1">
                        <Title id="_IDGenTitle1" text="{= ${DebitMemo>/Items} &amp;&amp; ${DebitMemo>/Items}.length > 0 ?  ${i18n>DebitMemo} + ' (' + ${DebitMemo>/Items}.length + ')' : ${i18n>DebitMemo} + ' (0)'}" level="H2"/>
                        <ToolbarSeparator id="_IDGenToolbarSeparator1"/>
                        <ToolbarSpacer id="_IDGenToolbarSpacer1"/>
                        <!-- <Button id="idDebitMemoBtn" text="Cancel" press=".onPressDmrMenu($event, 'Cancel', 'DebitMemoWizard')" tooltip="{i18n>CancelMsg}" enabled="{= ${DebitMemo>/bSelected} &amp;&amp; ${DebitMemo>/bValidate} &amp;&amp; (!${DebitMemo>/bCreditMemoExist} || ${DebitMemo>/bActualCustomerExist}) }"/> -->
                        <Button id="idDebitMemoBtn" text="Cancel" press=".onPressDmrMenu($event, 'Cancel', 'DebitMemoWizard')" tooltip="{i18n>CancelMsg}" enabled="{= ${DebitMemo>/bSelected} &amp;&amp; ${DebitMemo>/bCancelEnabled} }"/>
                        <Button id="_IDGenButton3" icon="sap-icon://action-settings" press=".openPersoDialog($event, 'idDebitMemoTable')"/>
                        <Button id="idLengedButton" icon="sap-icon://legend" press="handleOpenLegend($event, 'Legend', 'idLengedButton')" tooltip="Open legend" ariaHasPopup="Dialog" />
                    </OverflowToolbar>
                </t:extension>
                <t:noData>
                    <IllustratedMessage id="_IDGenIllustratedMessage1" enableVerticalResponsiveness="true"/>
                </t:noData>
                <t:rowSettingsTemplate>
                    <!-- <t:RowSettings highlight="{DebitMemo>Status}"/> highlight="{= ${DebitMemo>NetAmount} > ${DebitMemo>CancelledAmount} && ${DebitMemo>CancelledAmount} > 0 ? 'HighlightClass' : 'DefaultClass' }"-->
                    <t:RowSettings highlight="{= ${DebitMemo>NetAmount} > ${DebitMemo>CancelledAmount} &amp;&amp; ${DebitMemo>CancelledAmount} > 0 ? 'Warning' : 'None' }"/>
                </t:rowSettingsTemplate>
                <t:columns>
                    <t:Column id="idColBillingDocument" autoResizable="true" width="130px">
                        <Label text="{i18n>BillingDocument}" tooltip="{i18n>BillingDocument}" wrapping="false"/>
